---
import { siteConfig } from "../config";
const hasTestimonials = siteConfig.testimonials && siteConfig.testimonials.length > 0;
---

{
  hasTestimonials && (
    <section id="testimonials" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-gray-50 section-animate">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Kind Words
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
            <p class="mt-4 text-gray-500 text-base sm:text-lg">
              What colleagues and leaders say about working with me.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-6">
              {siteConfig.testimonials.map((testimonial, index) => (
                <div class="group relative bg-white rounded-xl border border-gray-200 p-5 sm:p-6 md:p-8 hover:shadow-lg transition-shadow duration-300">
                  <div
                    class="absolute -top-3 -left-2 text-5xl sm:text-6xl leading-none opacity-15 select-none"
                    style={`color: ${siteConfig.accentColor}`}
                  >
                    &ldquo;
                  </div>
                  <p class="text-base sm:text-lg text-gray-700 leading-relaxed italic mb-5 pl-4 border-l-2" style={`border-color: ${siteConfig.accentColor}30`}>
                    {testimonial.quote}
                  </p>
                  <div class="flex items-center gap-3">
                    <div
                      class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm"
                      style={`background: linear-gradient(135deg, ${siteConfig.accentColor}, ${siteConfig.accentColor}cc)`}
                    >
                      {testimonial.name.split(" ").map(n => n[0]).join("")}
                    </div>
                    <div>
                      <p class="font-semibold text-gray-900 text-sm sm:text-base">
                        {testimonial.name}
                      </p>
                      <p class="text-xs sm:text-sm text-gray-500">
                        {testimonial.title}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}